      <aliases enabled='yes' />
      <column caption='Catergory Target' datatype='integer' name='[Calculation_1230947653193728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [category]&#13;&#10;    WHEN &quot;Fruits &amp; Vegetables&quot; THEN 12000&#13;&#10;    WHEN &quot;Dairy &amp; Eggs&quot; THEN 16500&#13;&#10;    WHEN &quot;Snacks &amp; Beverages&quot; THEN 13000&#13;&#10;    WHEN &quot;Personal Care&quot; THEN 15500&#13;&#10;    WHEN &quot;Household Essentials&quot; THEN 17000&#13;&#10;    WHEN &quot;Bakery&quot; THEN 12000&#13;&#10;END' />
      </column>
      <column caption='Performance Tier' datatype='string' name='[Calculation_1230947654144002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([total_revenue]) &gt;= MIN(&#13;&#10;    CASE [category]&#13;&#10;        WHEN &quot;Fruits &amp; Vegetables&quot; THEN 12000&#13;&#10;        WHEN &quot;Dairy &amp; Eggs&quot; THEN 16500&#13;&#10;        WHEN &quot;Snacks &amp; Beverages&quot; THEN 13000&#13;&#10;        WHEN &quot;Personal Care&quot; THEN 15500&#13;&#10;        WHEN &quot;Household Essentials&quot; THEN 17000&#13;&#10;        WHEN &quot;Bakery&quot; THEN 12000&#13;&#10;    END&#13;&#10;) THEN&#13;&#10;    &quot;Above Target&quot;&#13;&#10;&#13;&#10;ELSEIF SUM([total_revenue]) &gt;= MIN(&#13;&#10;    CASE [category]&#13;&#10;        WHEN &quot;Fruits &amp; Vegetables&quot; THEN 12000&#13;&#10;        WHEN &quot;Dairy &amp; Eggs&quot; THEN 16500&#13;&#10;        WHEN &quot;Snacks &amp; Beverages&quot; THEN 13000&#13;&#10;        WHEN &quot;Personal Care&quot; THEN 15500&#13;&#10;        WHEN &quot;Household Essentials&quot; THEN 17000&#13;&#10;        WHEN &quot;Bakery&quot; THEN 12000&#13;&#10;    END&#13;&#10;) * 0.85 THEN&#13;&#10;    &quot;Below Target - Watch&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Below Target - Critical&quot;&#13;&#10;END' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_1230947657240579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_revenue]) / SUM([order_count])' />
      </column>
      <column caption='KPI - Categories Meeting Target' datatype='integer' name='[Calculation_1230947657633796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF { FIXED [category] : SUM([total_revenue]) }&#13;&#10;       &gt;=&#13;&#10;       { FIXED [category] :&#13;&#10;           MIN(&#13;&#10;               CASE [category]&#13;&#10;                   WHEN &quot;Fruits &amp; Vegetables&quot; THEN 12000&#13;&#10;                   WHEN &quot;Dairy &amp; Eggs&quot; THEN 16500&#13;&#10;                   WHEN &quot;Snacks &amp; Beverages&quot; THEN 13000&#13;&#10;                   WHEN &quot;Personal Care&quot; THEN 15500&#13;&#10;                   WHEN &quot;Household Essentials&quot; THEN 17000&#13;&#10;                   WHEN &quot;Bakery&quot; THEN 12000&#13;&#10;               END&#13;&#10;           )&#13;&#10;       }&#13;&#10;    THEN [category]&#13;&#10;    END&#13;&#10;)' />
      </column>
